	"tokenColors": [
		{
			"name": "Life Sciences - Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#8A9AAA",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Life Sciences - Keywords",
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#6BA8DC"
			}
		},
		{
			"name": "Life Sciences - Strings",
			"scope": ["string", "string.quoted"],
			"settings": {
				"foreground": "#7BB898"
			}
		},
		{
			"name": "Life Sciences - Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#D4956A"
			}
		},
		{
			"name": "Life Sciences - Functions",
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#5A8AB5"
			}
		},
		{
			"name": "Life Sciences - Classes",
			"scope": ["entity.name.class", "entity.name.type", "support.class"],
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "Life Sciences - Variables",
			"scope": ["variable", "variable.other"],
			"settings": {
				"foreground": "#4A5A6A"
			}
		},
		{
			"name": "Life Sciences - Constants",
			"scope": ["constant", "constant.language"],
			"settings": {
				"foreground": "#B898C8"
			}
		},
		{
			"name": "Life Sciences - Operators",
			"scope": ["keyword.operator"],
			"settings": {
				"foreground": "#6A7A8A"
			}
		},
		{
			"name": "Life Sciences - Punctuation",
			"scope": ["punctuation"],
			"settings": {
				"foreground": "#6A7A8A"
			}
		},
		{
			"name": "Life Sciences - Tags (HTML/XML)",
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#D98B8B"
			}
		},
		{
			"name": "Life Sciences - Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#D4A85A"
			}
		},
		{
			"name": "Life Sciences - Markdown Headings",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#5A8AB5",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Life Sciences - Markdown Bold",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#4A5A6A",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Life Sciences - Markdown Italic",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#4A5A6A",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Life Sciences - Markdown Links",
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#6BA8DC"
			}
		},
		{
			"name": "Life Sciences - Markdown Code",
			"scope": ["markup.inline.raw", "markup.raw"],
			"settings": {
				"foreground": "#7BB898"
			}
		}
	]
